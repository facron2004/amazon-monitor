{
  "name": "@amazon-monitor/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-warnings tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --no-warnings dist/index.js",
    "pretest": "npm --workspace @amazon-monitor/shared run build",
    "test": "cross-env NODE_OPTIONS=--no-warnings vitest run src"
  },
  "dependencies": {
    "@amazon-monitor/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.7",
    "playwright": "^1.57.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4"
  }
}
