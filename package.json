{
  "name": "amazon-keyword-competitor-monitor",
  "version": "0.1.0",
  "description": "Amazon 关键词竞品价格与排名监控系统",
  "author": "Amazon Monitor Team",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build:shared": "npm --workspace @amazon-monitor/shared run build",
    "dev": "npm run build:shared && npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @amazon-monitor/api run dev",
    "dev:web": "npm --workspace @amazon-monitor/web run dev",
    "test": "npm --workspace @amazon-monitor/shared run test && npm --workspace @amazon-monitor/api run test",
    "build": "npm run build:shared && npm --workspace @amazon-monitor/api run build && npm --workspace @amazon-monitor/web run build",
    "start": "node apps/api/dist/index.js",
    "collect": "cross-env ENABLE_CRON=false tsx apps/api/src/cli.ts collect",
    "collect:keyword": "cross-env ENABLE_CRON=false tsx apps/api/src/cli.ts keyword",
    "collect:category": "cross-env ENABLE_CRON=false tsx apps/api/src/cli.ts category",
    "collect:quality": "cross-env ENABLE_CRON=false tsx apps/api/src/cli.ts quality",
    "worker": "cross-env ENABLE_CRON=false tsx apps/api/src/worker.ts"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  }
}
