# =========================================================================
# Amazon 关键词价格与排名监控系统 - 环境变量配置模板
# 使用方法：复制本文件并重命名为 `.env`，然后修改下方的配置信息。
# =========================================================================

# -------------------------------------------------------------------------
# 1. 邮件推送服务 (SMTP 配置) - 必填
# -------------------------------------------------------------------------

# SMTP 服务器地址（常用的服务商地址如下：）
# - QQ 邮箱: smtp.qq.com
# - 163 邮箱: smtp.163.com
# - 腾讯企业邮: smtp.exmail.qq.com
# - 阿里企业邮: smtp.mxhichina.com
# - Gmail (需要当前网络/代理放行 SMTP 465/587): smtp.gmail.com
SMTP_HOST=smtp.qq.com

# SMTP 端口（通常有以下几种，根据你的邮箱类型和是否启用 SSL 决定）：
# - 端口 465：通常用于 SSL 安全连接（推荐，QQ/163 邮箱等最常用）
# - 端口 587：通常用于 TLS/STARTTLS 连接
# - 端口 25：非安全连接端口（已不推荐，许多云服务器会禁用此端口）
SMTP_PORT=465

# 是否开启 SSL 安全传输（开启为 true，关闭为 false）
# 如果端口是 465，请务必设置为 true
SMTP_SECURE=true

# 发信账号：你的邮箱完整地址
SMTP_USER=您的QQ号或邮箱账号@qq.com

# 发信授权密码/授权码（重要！注意：这不是你登录邮箱的常规密码，而是在邮箱设置里申请的 16位 独立“授权码”）
# 申请教程见本项目的“配置教程”
SMTP_PASS=这里填写你的16位邮箱授权密码

# 发件人显示邮箱（选填，不填则默认与 SMTP_USER 相同）
# 可以写：SMTP_FROM="Amazon 监控系统 <您的QQ号或邮箱账号@qq.com>"
SMTP_FROM=您的QQ号或邮箱账号@qq.com

# SMTP 网络代理（选填）
# Gmail 等海外 SMTP 在当前网络下可能需要代理，而且代理线路必须支持 SMTP 465/587。
# 本机有代理时可填：
# SMTP_PROXY=http://127.0.0.1:7890
# 如需强制直连，可填 SMTP_PROXY=direct

# SMTP 超时毫秒数（选填，默认 30000）
SMTP_TIMEOUT_MS=30000

# 端口 587 通常需要 STARTTLS；默认会自动开启。少数服务商不支持时可改为 false
SMTP_REQUIRE_TLS=true

# -------------------------------------------------------------------------
# 2. 系统通用配置 (选填)
# -------------------------------------------------------------------------

# API 后端服务运行的端口号（默认 4000）
PORT=4000

# 飞书推送里的 Excel 下载链接会使用这个公网地址拼接。
# 只在本机使用可以留空；邮箱仍会直接附带 .xlsx 文件。
# PUBLIC_BASE_URL=https://amazon-monitor.example.com

# 数据库文件保存路径 (默认保存在根目录下的 data/amazon-monitor.sqlite)
# DB_PATH=../../data/amazon-monitor.sqlite

# SQLite write-lock wait time in milliseconds.
SQLITE_BUSY_TIMEOUT_MS=10000

# 是否启用后台定时采集和计划调度任务（默认 true，填 false 仅做手动测试）
ENABLE_CRON=true

# -------------------------------------------------------------------------
# 3. Category Best Sellers collection tuning (optional)
# -------------------------------------------------------------------------

# Retry temporary Amazon Best Sellers page errors or empty-card pages.
AMAZON_COLLECT_CATEGORY_RETRIES=2

# Block font/media requests on Best Sellers pages to reduce wait time.
AMAZON_COLLECT_CATEGORY_BLOCK_RESOURCES=true

# Keep false by default so product image URLs stay stable in UI and reports.
AMAZON_COLLECT_CATEGORY_BLOCK_IMAGES=false

# Current Amazon Best Sellers pages normally expose Top 100 across 2 pages of 50.
# Used to decide how many pages to visit for Top N collection.
AMAZON_BESTSELLER_PAGE_SIZE=50

# Probe a couple of extra pages if Amazon renders fewer cards than expected on
# earlier Best Sellers pages. The strict Top N check still rejects partial runs.
AMAZON_BESTSELLER_EXTRA_PAGES=2

# Scroll each Best Sellers page before extraction so lazy-rendered cards are included.
AMAZON_BESTSELLER_SCROLL_PASSES=12
AMAZON_BESTSELLER_SCROLL_DELAY_MS=700
AMAZON_BESTSELLER_MIN_SCROLL_PASSES=6
AMAZON_BESTSELLER_STABLE_PASSES=4

# Cache product detail BSR results by date + marketplace + ASIN while the API process is running.
# This avoids opening the same product detail page repeatedly when multiple keywords find the same ASIN.
AMAZON_COLLECT_DETAIL_CACHE_ITEMS=5000

# Run multiple keyword monitors in parallel during "collect all".
# Increase only if the network and Amazon pages remain stable.
AMAZON_COLLECT_KEYWORD_CONCURRENCY=2

# Best Sellers pages are more sensitive; keep this conservative by default.
AMAZON_COLLECT_CATEGORY_CONCURRENCY=1

# Keep a desktop-wide viewport; Amazon only rendered 38 cards per Best Sellers page at 1280x720.
AMAZON_BESTSELLER_VIEWPORT_WIDTH=1920
AMAZON_BESTSELLER_VIEWPORT_HEIGHT=1080
